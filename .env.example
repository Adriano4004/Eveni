# Copiar para .env só em desenvolvimento local. No Railway, configurar em Variables.

# local | staging | production
APP_ENV=local
# Ligação ao PostgreSQL (no Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://eveni:eveni@localhost:5432/eveni
# Endereço público, sem "/" no fim
APP_URL=http://localhost:3000
# Proxies do alojamento à frente da aplicação (Railway: 1)
TRUST_PROXY_HOPS=1
# Pelo menos 32 caracteres aleatórios
SESSION_SECRET=
# Obrigatórias em production; opcionais em staging enquanto não houver domínio
RESEND_API_KEY=
EMAIL_FROM=

# Administradores (decisão 027): e-mails separados por vírgulas. Só eles vêem a administração dos planos,
# e só com a verificação em dois passos activa. Opcional.
ADMINS=
