      "papel": "Gestor",
      "inicio": -21,
      "fim": -20,
      "critica": true,
      "nota": "Uma mensagem. Se tens três, tens zero — o jornalista escolhe uma e não é a tua."
    },
    {
      "id": "T01-003",
      "fase": "Pré Produção",
      "categoria": "Estratégia",
      "titulo": "Aprovar porta-voz principal e substituto",
      "papel": "Gestor",
      "inicio": -20,
      "fim": -20,
