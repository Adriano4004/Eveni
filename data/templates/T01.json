      "titulo": "Segmentar lista de imprensa por meio",
      "papel": "Comunicação",
      "inicio": -12,
      "fim": -12,
      "critica": true,
      "nota": "TV precisa de imagem, rádio precisa de som, online precisa de rapidez, escrita precisa de dados. Convite igual para todos ignora isto."
