      "categoria": "Estratégia",
      "titulo": "Validar que existe facto novo",
      "papel": "Gestor",
      "inicio": -21,
      "fim": -21,
      "critica": true,
      "nota": "Se não há notícia, não há conferência. Convocar imprensa sem facto novo queima crédito que precisas na próxima."
    },
    {
      "id": "T01-002",
      "fase": "Pré Produção",
      "categoria": "Estratégia",
