      "id": "T01-005",
      "fase": "Pré Produção",
      "categoria": "Estratégia",
      "titulo": "Verificar conflitos de agenda no sector",
      "papel": "Comunicação",
      "inicio": -20,
      "fim": -20,
      "critica": false,
      "nota": "Se outra marca do sector convoca no mesmo dia, dividem-se as redacções e ambos perdem."
    },
